<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvProfileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perfil del chef"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProfileSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Trayectoria de la autora del recetario"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgChef"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="Foto de Elena Restrepo"
                android:scaleType="centerCrop"
                android:src="@drawable/elena_restrepo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvChefName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Elena Restrepo"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChefDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Chef de cocina colombiana contemporánea"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvRecipeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="4 recetas"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ciudad: Bogotá, Colombia"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvSpecialty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Especialidad: Cocina de raíz y repostería"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvStudiesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Estudios"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/studiesScroll"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:background="#F5F5F5"
            android:fillViewport="false"
            android:fadeScrollbars="false"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvStudies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:lineSpacingExtra="8dp"
                android:text="• Tecnóloga en Gastronomía (SENA, 2015)&#10;&#10;• Diplomado en panadería artesanal (2018)&#10;&#10;• Taller de cocina de fermentos (2021)&#10;&#10;• Curso de cocina colombiana tradicional (2022)&#10;&#10;• Seminario de cocina sostenible y aprovechamiento de alimentos (2023)&#10;&#10;• Taller de presentación y montaje de platos (2024)"
                android:textSize="16sp" />

        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="↕ Desliza para ver más"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvExperienceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Experiencia"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/experienceScroll"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:background="#F5F5F5"
            android:fadeScrollbars="false"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:lineSpacingExtra="8dp"
                android:text="• Jefe de cocina, Restaurante El Fogón (2019 - 2024)&#10;&#10;• Asesora gastronómica independiente (2024-hoy)&#10;&#10;• Docente de repostería, Academia Saber (2022)&#10;&#10;• Chef invitada en encuentros gastronómicos de cocina colombiana (2023)&#10;&#10;• Consultora para proyectos de cocina tradicional y productos locales (2024)&#10;&#10;• Tallerista de cocina colombiana contemporánea (2025)"
                android:textSize="16sp" />

        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="↕ Desliza para ver más"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPhilosophyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Filosofía de cocina"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPhilosophy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="6dp"
            android:text="Rescatar ingredientes locales y técnicas tradicionales, con recetas simples que cualquiera pueda preparar en casa"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
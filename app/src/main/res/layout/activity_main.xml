<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
        Todo el contenido real de SaborApp.

        Desde MainActivity.kt se desplazará hacia abajo
        exactamente la altura de la barra de estado.

        Al quedar el FrameLayout raíz detrás,
        la barra de estado verá el fondo negro.
    -->
    <LinearLayout
        android:id="@+id/appContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/cream">

        <!-- Barra superior de SaborApp -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@color/wine"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <!-- Nombre de la aplicación -->
            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SaborApp"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Recetario culinario"
                android:textColor="#E4C8D0"
                android:textSize="9sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Mostrar / ocultar menú -->
            <TextView
                android:id="@+id/btnToggleMenu"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:contentDescription="Mostrar u ocultar menú"
                android:focusable="true"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/white"
                android:textSize="27sp" />

        </LinearLayout>


        <!-- Menú + contenido principal -->
        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Panel lateral completo -->
            <LinearLayout
                android:id="@+id/menuPanel"
                android:layout_width="125dp"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/menuContainer"
                    android:layout_width="124dp"
                    android:layout_height="match_parent"
                    android:background="@color/cream_menu" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E4D6CA" />

            </LinearLayout>


            <!-- Contenido -->
            <FrameLayout
                android:id="@+id/contentContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/cream" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>